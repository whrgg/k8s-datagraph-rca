# DeepSeek API 配置（可选）
DEEPSEEK_API_KEY=""

# OpenAI API 配置
OPENAI_API_KEY=""
OPENAI_PROJECT_ID=""
OPENAI_ADMIN_API_KEY=""

# Telegram 通知（可选）
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# LangSmith 追踪（可选，建议开启）
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="k8s-datagraph-rca"

# K8s Datagraph RCA 运行时配置
# 单个 RCA Worker 的工具调用预算
MAX_TOOL_CALLS="8"
# 每轮并行执行的 RCA 任务数
RCA_TASKS_PER_ITERATION="3"
# 链路分析起始服务（如 frontend 或 nginx）
TRACE_SERVICE_STARTING_POINT="frontend"
# 每日 OpenAI Token 安全上限
MAX_DAILY_OPENAI_TOKEN_LIMIT="2000000"

# 可观测工具与集群访问
PROMETHEUS_SERVER_URL="http://localhost:9090"
JAEGER_URL="http://localhost:16686"
TARGET_NAMESPACE="default"

# Neo4j Datagraph 配置
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER=""
NEO4J_PASSWORD=""

# AIOpsLab 集成
# AIOpsLab 安装目录
AIOPSLAB_DIR="/path/to/AIOpsLab"
# 实验结果输出目录
RESULTS_PATH="Results"
